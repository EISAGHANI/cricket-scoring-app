{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "env": ["PROPERTY_RUNS"],
      "outputs": ["coverage/**"]
    }
  },
  "globalPassThroughEnv": ["DATABASE_URL", "TEST_DATABASE_URL", "PROPERTY_RUNS", "CI"]
}
