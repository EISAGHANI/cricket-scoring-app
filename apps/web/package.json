    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4.3.3",
