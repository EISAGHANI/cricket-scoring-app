# Copy to apps/web/.env.local. Values match infra/docker-compose.yml.
NEXT_PUBLIC_APP_URL=http://localhost:3000

DATABASE_URL=postgres://cricket:cricket@localhost:5432/cricket
# Generate your own: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters

# Optional: Google sign-in (create an OAuth client in Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email: Mailpit in dev (UI at http://localhost:8025). Set RESEND_API_KEY in production.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Cricket Platform <no-reply@cricket.local>
RESEND_API_KEY=

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000/cricket-media
S3_REGION=us-east-1
S3_BUCKET=cricket-media
S3_ACCESS_KEY_ID=cricket
S3_SECRET_ACCESS_KEY=cricket-secret
