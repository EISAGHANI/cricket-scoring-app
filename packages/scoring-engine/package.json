{
  "name": "@cricket/scoring-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Pure, deterministic cricket scoring engine. Zero framework/DB/IO dependencies.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "tsx tools/bench.ts",
    "replay": "tsx tools/cli.ts"
  },
  "devDependencies": {
    "@cricket/config": "workspace:*",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
